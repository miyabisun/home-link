<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lending the phone's BLE to matterjs-server while registering a new device. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 17 blocks LAN connections, including to the BLE proxy, without it; 16 ignores it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Android names the connected Wi-Fi only to apps with fine location; used to fill in the SSID. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Reading the connected network through ConnectivityManager. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sending a door command from the widget past Data Saver, as a short foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <application android:label="@string/app_name" android:icon="@drawable/ic_home_link"
        android:theme="@style/AppTheme" android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- The launcher opens it when a label widget is placed or set up again. -->
        <activity android:name=".WidgetConfigActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver android:name=".LabelSwitchWidget" android:exported="false"
            android:label="@string/label_switch_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/label_switch_widget_info" />
        </receiver>
        <receiver android:name=".LabelOnWidget" android:exported="false"
            android:label="@string/label_on">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/label_on_widget_info" />
        </receiver>
        <receiver android:name=".LabelOffWidget" android:exported="false"
            android:label="@string/label_off">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/label_off_widget_info" />
        </receiver>
        <receiver android:name=".LabelToggleWidget" android:exported="false"
            android:label="@string/label_toggle">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/label_toggle_widget_info" />
        </receiver>
        <receiver android:name=".DoorWidget" android:exported="false"
            android:label="@string/door_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/door_widget_info" />
        </receiver>
        <receiver android:name=".DoorLockWidget" android:exported="false"
            android:label="@string/door_lock_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/door_lock_widget_info" />
        </receiver>
        <service android:name=".DoorService" android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
