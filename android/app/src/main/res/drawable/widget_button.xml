<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/border">
    <item>
        <shape>
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/border" />
            <!-- The frame's radius less its 8dp padding, so the corners run parallel. -->
            <corners android:radius="@android:dimen/system_app_widget_inner_radius" />
        </shape>
    </item>
</ripple>
