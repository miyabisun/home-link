<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" style="@style/WidgetFrame" android:orientation="horizontal">
    <FrameLayout android:id="@+id/label_button" style="@style/WidgetButton" android:layout_marginEnd="8dp"
        android:contentDescription="@string/label_on">
        <TextView android:id="@+id/label_button_text" style="@style/WidgetButtonText"
            android:text="@string/label_on" android:drawableTop="@drawable/ic_light_on" />
    </FrameLayout>
    <FrameLayout android:id="@+id/label_button2" style="@style/WidgetButton"
        android:contentDescription="@string/label_off">
        <TextView android:id="@+id/label_button2_text" style="@style/WidgetButtonText"
            android:text="@string/label_off" android:drawableTop="@drawable/ic_light_off" />
    </FrameLayout>
</LinearLayout>
