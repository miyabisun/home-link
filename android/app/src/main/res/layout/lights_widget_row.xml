<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" style="@style/WidgetFrame" android:orientation="horizontal">
    <FrameLayout android:id="@+id/light_on" style="@style/WidgetButton" android:layout_marginEnd="8dp"
        android:contentDescription="@string/lights_on">
        <TextView android:id="@+id/light_on_text" style="@style/WidgetButtonText"
            android:text="@string/lights_on" android:drawableTop="@drawable/ic_light_on" />
    </FrameLayout>
    <FrameLayout android:id="@+id/light_off" style="@style/WidgetButton" android:layout_marginEnd="8dp"
        android:contentDescription="@string/lights_off">
        <TextView android:id="@+id/light_off_text" style="@style/WidgetButtonText"
            android:text="@string/lights_off" android:drawableTop="@drawable/ic_light_off" />
    </FrameLayout>
    <FrameLayout android:id="@+id/light_work" style="@style/WidgetButton" android:layout_marginEnd="8dp"
        android:contentDescription="@string/lights_work">
        <TextView android:id="@+id/light_work_text" style="@style/WidgetButtonText"
            android:text="@string/lights_work" android:drawableTop="@drawable/ic_work" />
    </FrameLayout>
    <FrameLayout android:id="@+id/light_task" style="@style/WidgetButton"
        android:contentDescription="@string/lights_task">
        <TextView android:id="@+id/light_task_text" style="@style/WidgetButtonText"
            android:text="@string/lights_task" android:drawableTop="@drawable/ic_task" />
    </FrameLayout>
</LinearLayout>
